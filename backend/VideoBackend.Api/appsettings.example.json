{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>"
  },
  "Poyo": {
    "ApiKey": "<poyo-api-key>"
  },
  "S3": {
    "Bucket": "<bucket-name>",
    "AccessKey": "<s3-access-key>",
    "SecretKey": "<s3-secret-key>",
    "Endpoint": "https://t3.storageapi.dev"
  },
  "Resend": {
    "ApiKey": "<resend-api-key>",
    "FromEmail": "onboarding@resend.dev"
  },
  "Paddle": {
    "Environment": "sandbox",
    "ApiKey": "<paddle-api-key>",
    "ClientToken": "<paddle-client-token>",
    "WebhookSecret": "<paddle-webhook-secret>",
    "PricePro": "pri_<pro-price-id>",
    "PriceUltra": "pri_<ultra-price-id>"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "<base64-secret-min-32-bytes>",
    "Issuer": "VideoBackend",
    "Audience": "VideoBackendUsers",
    "ExpiresInHours": 1
  }
}
